<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.FridaBox" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary (brand teal) -->
        <item name="colorPrimary">@color/fb_primary</item>
        <item name="colorOnPrimary">@color/m3_on_primary</item>
        <item name="colorPrimaryContainer">@color/m3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m3_on_primary_container</item>
        <!-- Secondary (purple) — also the navigation active-indicator tint -->
        <item name="colorSecondary">@color/fb_secondary</item>
        <item name="colorOnSecondary">@color/m3_on_secondary</item>
        <item name="colorSecondaryContainer">@color/m3_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/m3_on_secondary_container</item>
        <!-- Tertiary (success green) -->
        <item name="colorTertiary">@color/m3_tertiary</item>
        <item name="colorOnTertiary">@color/m3_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/m3_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/m3_on_tertiary_container</item>
        <!-- Surfaces + background -->
        <item name="android:colorBackground">@color/fb_background</item>
        <item name="colorOnBackground">@color/fb_text_primary</item>
        <item name="colorSurface">@color/m3_surface</item>
        <item name="colorOnSurface">@color/fb_text_primary</item>
        <item name="colorSurfaceVariant">@color/m3_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/m3_on_surface_variant</item>
        <item name="colorSurfaceDim">@color/m3_surface_dim</item>
        <item name="colorSurfaceBright">@color/m3_surface_bright</item>
        <item name="colorSurfaceContainerLowest">@color/m3_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/m3_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/m3_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/m3_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/m3_surface_container_highest</item>
        <!-- Outline -->
        <item name="colorOutline">@color/fb_outline</item>
        <item name="colorOutlineVariant">@color/m3_outline_variant</item>
        <!-- Error -->
        <item name="colorError">@color/fb_error</item>
        <item name="colorOnError">@color/m3_on_error</item>
        <item name="colorErrorContainer">@color/m3_error_container</item>
        <item name="colorOnErrorContainer">@color/m3_on_error_container</item>
        <!-- System bars + window -->
        <item name="android:windowBackground">@drawable/bg_liquid_glass_app</item>
        <item name="android:navigationBarColor">@color/fb_background</item>
        <item name="android:statusBarColor">@color/fb_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.FridaBox.Dialog</item>
    </style>

    <style name="ThemeOverlay.FridaBox.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/m3_surface_container_high</item>
        <item name="colorOnSurface">@color/fb_text_primary</item>
        <item name="colorPrimary">@color/fb_primary</item>
    </style>

    <style name="Widget.FridaBox.Navigation.ActiveIndicator" parent="">
        <item name="android:width">44dp</item>
        <item name="android:height">32dp</item>
        <item name="marginHorizontal">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.FridaBox.NavigationPill</item>
        <item name="android:color">@color/fb_nav_indicator</item>
    </style>

    <style name="ShapeAppearance.FridaBox.NavigationPill" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="TextAppearance.FridaBox.Navigation.Label" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">sans</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
    </style>
</resources>
